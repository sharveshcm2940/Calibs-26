# Database Connection URL (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/calibrations_db"

# Redis Cache & Rate Limiter (Optional - in-memory sliding window is used automatically if Redis is unavailable)
REDIS_URL="redis://localhost:6379"

# Authentication & Session Security (Change these in production)
JWT_SECRET="calibrations-kollywood-jwt-secret-2026-super-secure-key"
ADMIN_SESSION_SECRET="calibrations-admin-session-secret-key-2026"

# Rate Limiting Parameters
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_WINDOW_MS=600000

# Base URL
NEXT_PUBLIC_API_URL="http://localhost:3000"
